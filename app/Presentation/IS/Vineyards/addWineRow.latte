{*
FILE:     addWineRow.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for adding a new wine row to a vineyard
*}
{layout '../isLayout.latte'}


{* Top menu navigation for vineyards section *}
{block topMenuISAdditional}
    <a href="{link :IS:Vineyards:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vinohrady
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Přidat řádek vína
    </a>
{/block topMenuISAdditional}



{* Main panel for adding a new wine row to a vineyard *}
{block isMainPanel}
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-edit me-2"></i>
                        Přidání řádku vinné révy
                    </h4>
                </div>
                <div class="card-body p-4">
                    {* Wine row add form *}
                    {form addWineRowForm}
                        {* Row number input (required, must be unique) *}
                        <div class="mb-3">
                            <label for="rowNumber" class="form-label fw-semibold">
                                <i class="fas fa-hashtag me-2 text-muted"></i>{label rowNumber /}
                                <span class="text-danger">*</span>
                            </label>
                            {input rowNumber}
                            <span class="invalid-feedback">
                                {inputError rowNumber}
                            </span>
                        </div>

                        {* Variety selection input (required) *}
                        <div class="mb-3">
                            <label for="variety" class="form-label fw-semibold">
                                <i class="fas fa-seedling me-2 text-muted"></i>{label variety /}
                                <span class="text-danger">*</span>
                            </label>
                            {input variety}
                            <span class="invalid-feedback">
                                {inputError variety}
                            </span>
                        </div>
                        
                        {* Year input (required) *}
                        <div class="mb-3">
                            <label for="year" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt me-2 text-muted"></i>{label year /}
                                <span class="text-danger">*</span>
                            </label>
                            {input year}
                            <span class="invalid-feedback">
                                {inputError year}
                            </span>
                        </div>
                        
                        {* Head count input (required) *}
                        <div class="mb-3">
                            <label for="headCount" class="form-label fw-semibold">
                                <i class="fas fa-calculator me-2 text-muted"></i>{label headCount /}
                                <span class="text-danger">*</span>
                            </label>
                            {input headCount}
                            <span class="invalid-feedback">
                                {inputError headCount}
                            </span>
                        </div>

                        {* Information note for users about row uniqueness and assignment *}
                        <div class="alert alert-info mb-4">
                            <h6 class="fw-bold mb-2">
                                <i class="fas fa-info-circle me-2"></i>Informace
                            </h6>
                            <small class="mb-0">
                                • Řádek bude přidán do vybraného vinohradu<br>
                                • Číslo řádku musí být jedinečné<br>
                                • Výchozí číslo řádku je nastaveno na první volné v rámci vinohradu
                            </small>
                        </div>

                        {* Form action buttons: Cancel and Save *}
                        <div class="border-top pt-4">
                            <div class="row">
                                <div class="col-12 col-md-6 mb-3 mb-md-0">
                                    <a href="{link show $vineyard->getId()}" class="btn btn-outline-secondary w-100 fw-bold">
                                        <i class="fas fa-times me-2"></i>Zrušit
                                    </a>
                                </div>
                                <div class="col-12 col-md-6">
                                    {input save}
                                    <span class="invalid-feedback">
                                        {inputError save}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {/form}
                </div>
            </div>
        </div>
    </div>

{/block isMainPanel}