{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <i class="fas fa-arrow-right me-2"></i>Vinohrady
    <i class="fas fa-arrow-right me-2 ms-2"></i>Přidat vinohrad
{/block topMenuISAdditional}


{block isMainPanel}
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-edit me-2"></i>
                        Přidání vinohradu
                    </h4>
                </div>
                <div class="card-body p-4">
                    {form addVineyardForm}
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">
                                <i class="fas fa-tag me-2 text-muted"></i>Název vinohradu
                                <span class="text-danger">*</span>
                            </label>
                            {input name}
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label fw-semibold">
                                <i class="fas fa-map-marker-alt me-2 text-muted"></i>Lokalita
                                <span class="text-danger">*</span>
                            </label>
                            {input location}
                        </div>
                        
                        <div class="mb-3">
                            <label for="year" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt me-2 text-muted"></i>Rok založení
                                <span class="text-danger">*</span>
                            </label>
                            {input year}
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label fw-semibold">
                                <i class="fas fa-file-alt me-2 text-muted"></i>Detailní popis
                                <span class="text-danger">*</span>
                            </label>
                            {input description}
                        </div>
                        
                        <div class="mb-3">
                            <label for="image" class="form-label fw-semibold">
                                <i class="fas fa-camera me-2 text-muted"></i>Přidat obrázek
                            </label>
                            {input image}
                        </div>

                        {* Information note *}
                        <div class="alert alert-info mb-4">
                            <small class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Poznámka:</strong> Přidávání a úprava řad vín a dalších podrobností bude k dispozici po vytvoření vinohradu na jeho editační stránce.
                            </small>
                        </div>

                        <div class="border-top pt-4">
                            <div class="row">
                                <div class="col-12 col-md-6 mb-3 mb-md-0">
                                    <a href="{link Vineyards:dashboard}" class="btn btn-outline-secondary w-100 fw-bold">
                                        <i class="fas fa-times me-2"></i>Zrušit
                                    </a>
                                </div>
                                <div class="col-12 col-md-6">
                                    {input send}
                                </div>
                            </div>
                        </div>
                    {/form}
                </div>
            </div>
        </div>
    </div>

{/block isMainPanel}