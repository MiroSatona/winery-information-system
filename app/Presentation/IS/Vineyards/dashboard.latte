{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <i class="fas fa-arrow-right me-2"></i>Vinohrady
{/block topMenuISAdditional}

{block isMainPanel}
    <div class="container-fluid"> 
        {* Main vineyard details section *}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold">
                                <i class="fas fa-mountain me-2"></i>
                                Přehled vinohradů
                            </h4>

                            <div class="flex-fill d-flex justify-content-center px-3">
                                {form searchVineyardsForm}
                                    <div class="input-group" style="max-width:520px; min-width:400px;">
                                        {input search}
                                        {input send}
                                    </div>
                                {/form}
                            </div>
                            
                            <div class="d-flex gap-2">
                                <a href="{link :IS:Dashboard:view}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-arrow-left me-2"></i>Zpět na přehled
                                </a>
                                <a href="{link Vineyards:add}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus me-2"></i>Přidat vinohrad
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div>
                                <span class="text-muted">Celkem vinohradů: <strong>{count($vineyards)}</strong></span>
                            </div>
                        </div>
                    </div>


                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-mountain me-2"></i>Název
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-map-marker-alt me-2"></i>Lokalita
                                        </th>
                                        <th scope="col" class="fw-bold text-center">
                                            <i class="fas fa-grip-lines me-2"></i>Řádků
                                        </th>
                                        <th scope="col" class="fw-bold text-center">
                                            <i class="fas fa-seedling me-2"></i>Odrůd
                                        </th>
                                        <th scope="col" class="fw-bold text-center">
                                            <i class="fas fa-calendar-alt me-2"></i>Založen
                                        </th>
                                        <th scope="col" class="fw-bold text-center">
                                            <i class="fas fa-image me-2"></i>Obrázek
                                        </th>
                                        <th scope="col" class="fw-bold text-center" style="width: 200px;">
                                            <i class="fas fa-cogs me-2"></i>Akce
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {foreach $vineyards as $vineyard}
                                        <tr class="align-middle">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold text-dark">{$vineyard->getName()}</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-muted">{$vineyard->getLocation()}</span>
                                            </td>
                                            <td class="text-center">
                                                {$vineyard->getWineRowsCount()}
                                            </td>
                                            <td class="text-center">
                                                {$vineyard->getWineVarietiesCount()}
                                            </td>
                                            <td class="text-center">
                                                <span class="text-muted">
                                                    {$vineyard->getYearEstablished()}
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                {if $vineyard->getImage()}
                                                        <i class="fas fa-check me-1"></i>
                                                {else}
                                                        <i class="fas fa-times me-1"></i>
                                                {/if}
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <a href="{link Vineyards:show $vineyard->getId()}" 
                                                    class="btn btn-outline-primary btn-sm" 
                                                    title="Detail vinohradu">
                                                        <i class="fas fa-bars me-1"></i>Detail
                                                    </a>
                                                    <button type="button" 
                                                            class="btn btn-outline-danger btn-sm" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#deleteModal{$vineyard->getId()}"
                                                            title="Smazat vinohrad">
                                                        <i class="fas fa-trash me-1"></i>Smazat
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {/foreach}
                                    {if count($vineyards) === 0}
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="fas fa-mountain fa-3x mb-3 opacity-50"></i>
                                                <h5>Žádné vinohrady</h5>
                                                <p>Zatím nejsou přidány žádné vinohrady.</p>
                                                <a href="{link Vineyards:add}" class="btn btn-primary">
                                                    <i class="fas fa-plus me-2"></i>Přidat první vinohrad
                                                </a>
                                            </td>
                                        </tr>
                                    {/if}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {* Delete confirmation modal*}
    {foreach $vineyards as $vineyard}
        <div class="modal fade" id="deleteModal{$vineyard->getId()}" tabindex="-1" aria-labelledby="deleteModalLabel{$vineyard->getId()}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="deleteModalLabel{$vineyard->getId()}">
                            <i class="fas fa-exclamation-triangle me-2"></i>Potvrdit smazání
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fas fa-mountain fa-3x text-danger mb-3"></i>
                            <h5>Opravdu chcete smazat vinohrad?</h5>
                            <p class="text-muted">
                                <strong>{$vineyard->getName()}</strong><br>
                                Lokalita: {$vineyard->getLocation()}<br>
                                Tato akce je nevratná. Společně s vinohradem budou odstraněny i všechny položky, které jej využívají.
                                Toto zahrnuje řádky, vína, ošetření, sklizně, atd.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Zrušit
                        </button>
                        <a href="{link delete!, $vineyard->getId()}" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Smazat vinohrad
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {/foreach}
    

{/block isMainPanel}