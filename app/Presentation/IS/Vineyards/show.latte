{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <a href="{link :IS:Vineyards:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vinohrady
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Detail vinohradu
    </a>
{/block topMenuISAdditional}


{block isMainPanel}
    <div class="container-fluid">
        {* Main vineyard details section *}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold">
                                <i class="fas fa-mountain me-2"></i>
                                Detail vinohradu
                            </h4>
                            <div class="d-flex gap-2">
                                <a href="{link Vineyards:dashboard}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-arrow-left me-2"></i>Zpět na přehled
                                </a>
                                {if $userVintner}
                                    <a href="{link Vineyards:edit, vineyardId => $vineyard->getId()}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-edit me-2"></i>Upravit vinohrad
                                    </a>
                                {/if}
                            </div>
                        </div>
                    </div>


                    <div class="card-body p-4">
                        <div class="row">
                            {* Vineyard information *}
                            <div class="col-12 col-md-8">
                                <div class="mb-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-mountain me-2"></i>Název vinohradu
                                        </label>
                                        <p class="fs-5 fw-bold text-dark mb-2">{$vineyard->getName()}</p>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-map-marker-alt me-2"></i>Lokalita
                                        </label>
                                        <p class="fs-6 text-dark mb-2">{$vineyard->getLocation()}</p>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-calendar-alt me-2"></i>Rok založení
                                        </label>
                                        <p class="fs-6 text-dark mb-2">{$vineyard->getYearEstablished()}</p>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-align-left me-2"></i>Detailní popis
                                        </label>
                                        <p class="text-dark mb-2">{$vineyard->getDescription()}</p>
                                    </div>

                                    <hr>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-seedling me-2"></i>Unikátní počet odrůd: {$vineyard->getWineVarietiesCount()} 
                                        </label>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-grip-lines me-2"></i>Počet řádků: {$vineyard->getWineRowsCount()}
                                        </label>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-calculator me-2"></i>Celkový počet keřů: {$vineyard->getTotalHeadCount()}
                                        </label>
                                    </div>
                                </div>
                                
                                
                            </div>

                            {* Vineyard image *}
                            <div class="col-12 col-md-4">
                                <div class="vineyard-image-container border rounded p-3 bg-light">
                                    {if $vineyard->getImage()}
                                        <img src="{asset $imageRepository->getPathForImage($vineyard->getImage())}" 
                                             alt="{$vineyard->getImage()->description}" 
                                             class="img-fluid rounded shadow-sm">
                                    {else}
                                        <div class="no-image-placeholder text-center">
                                            <i class="fas fa-image fa-4x text-muted mb-3"></i>
                                            <p class="text-muted mb-0">Bez obrázku</p>
                                        </div>
                                    {/if}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {* Wine varieties section *}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">
                                <i class="fas fa-seedling me-2"></i>Odrůdy vína
                            </h5>
                            <a href="{link :IS:WineVarieties:dashboard}" class="btn btn-primary btn-sm">
                                <i class="fas fa-seedling me-2"></i>Přehled odrůd
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        {if count($wineVarieties) > 0}
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-primary">
                                        <tr>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-seedling me-2"></i>Název
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-palette me-2"></i>Barva
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-align-left me-2"></i>Popis
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-calculator me-2"></i>Počet keřů
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $wineVarieties as $variety}
                                            <tr class="align-middle">
                                                <td>
                                                    <h6 class="mb-0 fw-semibold text-dark">{$variety->getName()}</h6>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">
                                                        {switch $variety->getColor()}
                                                            {case $WineVarietyType::WHITE}
                                                                Bílé
                                                            {case $WineVarietyType::RED}
                                                                Červené
                                                            {case $WineVarietyType::PINK}
                                                                Růžové
                                                            {case $WineVarietyType::GREY}
                                                                Šedé
                                                            {case $WineVarietyType::BLUE}
                                                                Modré
                                                        {/switch}
                                                    </span>
                                                </td>
                                                <td>
                                                    <p class="mb-0 text-muted">
                                                        {if strlen($variety->getDescription()) > 120}
                                                            {$variety->getDescription()|truncate:120}
                                                        {else}
                                                            {$variety->getDescription()}
                                                        {/if}
                                                    </p>
                                                </td>
                                                <td>
                                                    <p class="mb-0 fw-semibold text-dark">
                                                        {$wineVarietiesHeadCount[$variety->getId()]}
                                                    </p>
                                                </td>
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            </div>
                        {else}
                            <div class="text-center py-5">
                                <i class="fas fa-wine-glass fa-3x text-muted mb-3 opacity-50"></i>
                                <h5 class="text-muted">Žádné odrůdy vína</h5>
                                <p class="text-muted">Na tomto vinohradu neroste žádná odrůda vína.</p>
                            </div>
                        {/if}
                    </div>
                </div>
            </div>
        </div>

        {* Wine rows section *}
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">
                                <i class="fas fa-grip-lines me-2"></i>Řádky vína
                            </h5>

                            <div class="flex-fill d-flex justify-content-center px-3">
                                {form searchWineRowsForm}
                                    <div class="d-flex gap-2 align-items-center" style="max-width:550px; min-width:550px;">
                                        {input search}
                                        {input type}
                                        {input send}
                                        <span class="invalid-feedback">
                                            {inputError search}
                                            {inputError type}
                                            {inputError send}
                                        </span>
                                    </div>
                                {/form}
                            </div>
                            {if $userVintner}
                                <a href="{link addWineRow $vineyard->getId()}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus me-2"></i>Přidat řádek
                                </a>
                            {/if}
                        </div>
                    </div>
                    <div class="card-body p-0">
                        {if count($wineRows) > 0}
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-primary">
                                        <tr>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-hashtag me-2"></i>Kód řádku
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-calendar-alt me-2"></i>Rok výsadby
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-seedling me-2"></i>Odrůda
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-calculator me-2"></i>Počet keřů
                                            </th>
                                            {if $userVintner}
                                                <th scope="col" class="fw-bold text-center" style="width: 250px;">
                                                    <i class="fas fa-cogs me-2"></i>Akce
                                                </th>
                                            {/if}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $wineRows as $row}
                                            <tr class="align-middle {if !$row->isActive()}table-secondary{/if}">
                                                <td>
                                                    <span class="fw-semibold">{$row->getId()}</span>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">{$row->getYearPlanted()}</span>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">
                                                        {$row->getWineVariety()->getName()}
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">{$row->getHeadCount()}</span>
                                                </td>
                                                {if $userVintner}
                                                    <td>
                                                        <div class="d-flex gap-2 justify-content-center">
                                                            {if $row->isActive()}
                                                                <a href="{link editWineRow $vineyard->getId(), $row->getId()}" 
                                                                class="btn btn-outline-primary btn-sm" 
                                                                title="Upravit řádek">
                                                                    <i class="fas fa-edit me-1"></i>Upravit
                                                                </a>
                                                            {/if}
                                                            {if $row->isActive()}
                                                                <button type="button" 
                                                                        class="btn btn-outline-danger btn-sm" 
                                                                        data-bs-toggle="modal" 
                                                                        data-bs-target="#deleteRowModal{$row->getId()}"
                                                                        title="Smazat řádek">
                                                                    <i class="fas fa-trash me-1"></i>Smazat
                                                                </button>
                                                            {else}
                                                                <button type="button" 
                                                                        class="btn btn-outline-success btn-sm" 
                                                                        data-bs-toggle="modal" 
                                                                        data-bs-target="#reactivateRowModal{$row->getId()}"
                                                                        title="Obnovit řádek">
                                                                    <i class="fas fa-eye me-1"></i>Obnovit
                                                                </button>
                                                            {/if}
                                                            

                                                        </div>
                                                    </td>
                                                {/if}
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            </div>
                        {else}
                            <div class="text-center py-5">
                                <i class="fas fa-grip-lines fa-3x text-muted mb-3 opacity-50"></i>
                                <h5 class="text-muted">Žádné řádky vína</h5>
                                <p class="text-muted">Na tomto vinohradu nejsou zatím žádné řádky vína.</p>
                            </div>
                        {/if}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {* Delete Confirmation Modals for Wine Rows *}
    {foreach $wineRows as $row}
        <div class="modal fade" id="deleteRowModal{$row->getId()}" tabindex="-1" aria-labelledby="deleteRowModalLabel{$row->getId()}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="deleteRowModalLabel{$row->getId()}">
                            <i class="fas fa-exclamation-triangle me-2"></i>Potvrdit smazání
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fas fa-grip-lines fa-3x text-danger mb-3"></i>
                            <h5>Opravdu chcete smazat řádek vína?</h5>
                            <p class="text-muted">
                                <strong>Řádek {$row->getId()}</strong><br>
                                Odrůda: <strong>{$row->getWineVariety()->getName()}</strong><br>
                                Rok výsadby: <strong>{$row->getYearPlanted()}</strong><br>
                                Počet keřů: <strong>{$row->getHeadCount()}</strong><br>
                                Smazáním řádku dojde k jeho deaktivaci a nebude možné jej nadále využívat.
                                Řádky je možné později obnovit.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Zrušit
                        </button>
                        <a href="{link deleteWineRow! $row->getId()}" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Smazat řádek
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {/foreach}

    {* Reactivation Confirmation Modals for Wine Rows *}
    {foreach $wineRows as $row}
        {if !$row->isActive()}
            <div class="modal fade" id="reactivateRowModal{$row->getId()}" tabindex="-1" aria-labelledby="reactivateRowModalLabel{$row->getId()}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="reactivateRowModalLabel{$row->getId()}">
                                <i class="fas fa-eye me-2"></i>Potvrdit obnovení
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="text-center">
                                <i class="fas fa-grip-lines fa-3x text-success mb-3"></i>
                                <h5>Opravdu chcete obnovit řádek vína?</h5>
                                <p class="text-muted">
                                    <strong>Řádek {$row->getId()}</strong><br>
                                    Odrůda: <strong>{$row->getWineVariety()->getName()}</strong><br>
                                    Rok výsadby: <strong>{$row->getYearPlanted()}</strong><br>
                                    Počet keřů: <strong>{$row->getHeadCount()}</strong><br>
                                    Obnovením se řádek znovu aktivuje a bude možné jej využívat.
                                </p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times me-1"></i>Zrušit
                            </button>
                            <a href="{link reactivateWineRow! $row->getId()}" class="btn btn-success">
                                <i class="fas fa-eye me-1"></i>Obnovit řádek
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {/if}
    {/foreach}

{/block isMainPanel}