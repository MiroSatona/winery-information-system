{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <i class="fas fa-arrow-right me-2"></i>Úkony
    <i class="fas fa-arrow-right me-2 ms-2"></i>Tvorba úkonu
{/block}

{block isMainPanel}
<div class="d-flex justify-content-center align-items-center h-100">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="fas fa-tasks me-2"></i>Nový úkon
                </h4>
            </div>

            <div class="card-body p-4">
                {form addTaskForm}

                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">
                            <i class="fas fa-tag me-2 text-muted"></i>{label name /}
                            <span class="text-danger">*</span>
                        </label>
                        {input name}
                    </div>

                    <div class="mb-3">
                        <label for="type" class="form-label fw-semibold">
                            <i class="fas fa-list me-2 text-muted"></i>{label type /}
                            <span class="text-danger">*</span>
                        </label>
                        {input type}
                    </div>

                    <div class="mb-3">
                        <label for="planned_date" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt me-2 text-muted"></i>{label planned_date /}
                            <span class="text-danger">*</span>
                        </label>
                        {input planned_date}
                    </div>

                    <div class="mb-3">
                        <label for="note" class="form-label fw-semibold">
                            <i class="fas fa-sticky-note me-2 text-muted"></i>{label note /}
                        </label>
                        {input note}
                    </div>

                    <div class="alert alert-info mb-4">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-info-circle me-2"></i>Informace
                        </h6>
                        <small class="mb-0">Zadejte údaje úkonu a stiskněte potvrdit pro uložení.</small>
                    </div>

                    <div class="border-top pt-4">
                        <div class="row">
                           <div class="col-12 col-md-6 mb-3 mb-md-0">
                            <a class="btn btn-secondary w-100 fw-bold" n:href="clearForm!"  role="button">
                                Zrušit
                            </a>
                            </div>
                            <div class="col-12 col-md-6">
                                {input send}
                            </div>
                        </div>
                    </div>

                {/form}
            </div>
        </div>
    </div>
</div>
{/block isMainPanel}
