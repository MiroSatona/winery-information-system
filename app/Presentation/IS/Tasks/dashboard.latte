{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <i class="fas fa-arrow-right me-2"></i>Úkony
{/block topMenuISAdditional}


{block isMainPanel}
     <div class="container-fluid">
        {* Main wine details section *}
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold">
                                <i class="fas fa-clipboard me-2"></i>
                                Přehled úkonů
                            </h4>

                            <div class="flex-fill d-flex justify-content-start px-3">
                                {form filterForm}
                                    <div class="d-flex gap-2 align-items-center" style="max-width:800px; width:100%;">
                                        {input pattern}
                                        {input type}
                                        {input state}
                                        {input send}
                                    </div>
                                {/form}
                            </div>
                            
                            <div class="d-flex gap-2">
                                <a href="" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-arrow-left me-2"></i>Zpět na přehled
                                </a>
                                <a n:href="addTask1" class="btn btn-primary btn-sm">
                                    <i class="fas fa-clipboard me-2"></i>Vytvořit úkon
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div>
                                <span class="text-muted"><strong>Celkový počet úkonů:</strong></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-clipboard-list me-2"></i>Název
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-tags me-2"></i>Typ
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-calendar-alt me-2"></i>Plán. dokončení
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-check-circle me-2"></i>Datum dokončení
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-toggle-on me-2"></i>Stav
                                        </th>
                                        <th scope="col" class="fw-bold">
                                            <i class="fas fa-cogs me-2"></i>Akce
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block isMainPanel}