
{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <a href="{link :IS:Tasks:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Úkony
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Sklizeň
    </a>
{/block topMenuISAdditional}


{block isMainPanel}
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-10 col-lg-9 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-seedling me-2"></i>
                        Výběr vinohradu, odrůdy a řádků
                    </h4>
                </div>
                <div class="card-body p-4">
                    {form selectVineyard}
                        <div class="mb-4">
                            <div class="row g-3 align-items-end">
                                <div class="col-9">
                                    <label for="vineyard" class="form-label fw-semibold">
                                        <i class="fas fa-mountain me-2 text-muted"></i>{label vineyard /}
                                    </label>
                                    {input vineyard}
                                    <span class="invalid-feedback">
                                        {inputError vineyard}
                                    </span>
                                </div>
                                <div class="col-3">
                                    {input submit}
                                    <span class="invalid-feedback">
                                        {inputError submit}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {/form}

                    {form selectWineVariety}
                        <div class="mb-4">
                            <div class="row g-3 align-items-end">
                                <div class="col-9">
                                    <label for="wineVariety" class="form-label fw-semibold">
                                        <i class="fas fa-grape-cluster me-2 text-muted"></i>{label wineVariety /}
                                    </label>
                                    {input wineVariety}
                                    <span class="invalid-feedback">
                                        {inputError wineVariety}
                                    </span>
                                </div>
                                <div class="col-3">
                                    {input submit}
                                    <span class="invalid-feedback">
                                        {inputError submit}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {/form}

                    {form selectRowsForm}
                        <div class="mb-4">
                            <div class="row g-3 align-items-end">
                                <div class="col-9">
                                    <label for="rows" class="form-label fw-semibold">
                                        <i class="fas fa-ruler-vertical me-2 text-muted"></i>{label rows /}
                                    </label>
                                    {input rows}
                                    <span class="invalid-feedback">
                                        {inputError rows}
                                    </span>
                                </div>
                                <div class="col-3">
                                    {input addRow}
                                    <span class="invalid-feedback">
                                        {inputError addRow}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold m-0">
                                    <i class="fas fa-check-circle me-2 text-success"></i>
                                    Vybrané řádky
                                </h5>
                                <div>
                                    {if $selectedRows && count($selectedRows) > 0}
                                        {input clearRows}
                                    {/if}
                                </div>
                            </div>

                            {if $selectedRows && count($selectedRows) > 0}
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" class="fw-bold">Řádek</th>
                                                <th scope="col" class="fw-bold">Počet trsů</th>
                                                <th scope="col" class="fw-bold">Rok výsadby</th>
                                                <th scope="col" class="fw-bold text-center" style="width: 120px;">Akce</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {foreach $selectedRows as $row}
                                                <tr class="align-middle">
                                                    <td class="fw-semibold">{$row->getId()}</td>
                                                    <td>{$row->getHeadCount()}</td>
                                                    <td>{$row->getYearPlanted()}</td>
                                                    <td class="text-center">
                                                        <a href="{link removeRowFromSelection! $row->getId()}" class="btn btn-sm btn-outline-danger">
                                                            <i class="fas fa-trash-alt me-1"></i>Odebrat
                                                        </a>
                                                    </td>
                                                </tr>
                                            {/foreach}
                                        </tbody>
                                    </table>
                                </div>
                            {else}
                                <div class="alert alert-info">
                                    <h6 class="fw-bold mb-2">
                                        <i class="fas fa-info-circle me-2"></i>Informace
                                    </h6>
                                    <small class="mb-0">Zatím nejsou vybrány žádné řádky. Vyberte řádek z dropdownu a přidejte ho.</small>
                                </div>
                            {/if}
                        </div>

                        <div class="border-top pt-4">
                            <div class="row g-2">
                                <div class="col-4">
                                    {input backToDashboard}
                                    <span class="invalid-feedback">
                                        {inputError backToDashboard}
                                    </span>
                                </div>
                                <div class="col-4">
                                    {input goBack}
                                    <span class="invalid-feedback">
                                        {inputError goBack}
                                    </span>
                                </div>
                                <div class="col-4">
                                    {input next}
                                    <span class="invalid-feedback">
                                        {inputError next}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {/form}
                </div>
            </div>
        </div>
    </div>
{/block isMainPanel}