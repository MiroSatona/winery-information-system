{*
FILE:     detailTreatment.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for displaying details of vineyard treatment task.
*}

{layout '../isLayout.latte'}

{block topMenuISAdditional}
    {* Navigation links for the IS Tasks dashboard and current treatment detail *}
    <a href="{link :IS:Tasks:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Úkony
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Detaily o ošetření
    </a>
{/block topMenuISAdditional}


{block isMainPanel}
    {* Header with general task info (date, state, etc.) *}
    {include 'detailHeader.latte', task: $task}

    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">

                    <!-- Card header: Title for the treatment detail section -->
                    <div class="card-header text-dark py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-flask me-2"></i>Specifické informace o ošetření
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-12 col-md-8">
                                <div class="mb-4">

                                    <!-- Basic treatment info: type and name -->
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-tag me-2"></i>Typ
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$task->getTypeText()}</p>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-prescription-bottle me-2"></i>Název ošetření
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$task->getNameTreatment()}</p>
                                        </div>
                                    </div>

                                    {* Show quantity and unit if available *}
                                    {if $task->getQuantity() !== null && $task->getUnit() !== null}
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold text-muted">
                                                    <i class="fas fa-tint me-2"></i>Množství
                                                </label>
                                                <p class="fs-6 text-dark mb-2">{$task->getQuantity()} {$task->getUnit()}</p>
                                            </div>
                                        </div>  
                                    {/if}

                                    <hr>

                                    <!-- Vineyard info and treated rows section -->
                                    <div class="mb-3">
                                        <h5 class="fw-semibold text-muted mb-3">
                                            <i class="fas fa-map-marker-alt me-2"></i>Vinohrad
                                        </h5>

                                        <p class="fs-6 text-dark mb-4">{$task->getVineyard()->getName()}</p>

                                        <div class="row mt-4">
                                            <div class="col-12">

                                                <!-- Treated rows table and add-row form (if planned) -->
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h5 class="fw-semibold text-muted mb-0">
                                                        <i class="fas fa-list me-2"></i>Ošetřené řádky
                                                    </h5>

                                                    {* Show add-row form only if task is in PLANNED state *}
                                                    {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                        {form addRowForm}
                                                            <div class="d-flex align-items-end gap-2">
                                                                {input rowCode}
                                                                {input send}
                                                            </div>
                                                        {/form}
                                                    {/if}
                                                </div>

                                                {if $wineRows}
                                                    <div class="table-responsive">
                                                        <table class="table table-primary">
                                                            <thead>
                                                                <tr>
                                                                    <th><i class="fas fa-hashtag me-2"></i>Kód řádku</th>
                                                                    <th><i class="fas fa-seedling me-2"></i>Počet keřů</th>
                                                                    <th><i class="fas fa-calendar-alt me-2"></i>Rok výsadby</th>
                                                                    <th><i class="fas fa-check-circle me-2"></i>Aktivní</th>
                                                                    {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                                        <th><i class="fas fa-cog me-2"></i>Akce</th>
                                                                    {/if}
                                                                </tr>
                                                            </thead>

                                                            {* Show warning if any row is in conflict with harvest *}
                                                            {if $task->isInConflict()}
                                                                <div class="text-danger mt-2 mb-1">
                                                                    <i class="fas fa-exclamation-triangle ms-2"></i>
                                                                    Rows marked in red are in conflict with harvest (less than 14 days between harvest and treatment).
                                                                </div>
                                                            {/if}
                                                            <tbody>
                                                                {foreach $wineRows as $wineRow}
                                                                    <tr class="{if $wineRow->isInConflict()} 
                                                                                    table-danger text-white 
                                                                                {else} 
                                                                                    table-light text-dark 
                                                                                {/if}">
                                                                        <td><strong>{$wineRow->getId()}</strong></td>
                                                                        <td>{$wineRow->getHeadCount()}</td>
                                                                        <td>{$wineRow->getYearPlanted()}</td>
                                                                        <td>
                                                                            {if $wineRow->isActive()}
                                                                                <span class="badge bg-success">Ano</span>
                                                                            {else}
                                                                                <span class="badge bg-danger">Ne</span>
                                                                            {/if}
                                                                        </td>

                                                                        {* Allow row removal if task is planned *}
                                                                        {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                                            <td class="text-center">
                                                                                <a n:href="deleteTaskRows! $wineRow->getId()"
                                                                                class="btn btn-sm btn-outline-danger">
                                                                                    <i class="fas fa-minus me-1"></i>Odebrat
                                                                                </a>
                                                                            </td>
                                                                        {/if}
                                                                    </tr>
                                                                {/foreach}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                {else}
                                                    <!-- No rows assigned message -->
                                                    <p class="text-muted">Žádné vinné řádky nejsou přiřazeny.</p>
                                                {/if}

                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div> <!-- card -->
            </div> <!-- col -->
        </div> <!-- row -->
    </div> <!-- container-fluid -->

{/block isMainPanel}
