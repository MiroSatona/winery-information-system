{*
FILE:     markHarvestDone.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for marking a harvest as completed in the IS Tasks module
*}

{* Use the IS layout for this page *}
{layout '../isLayout.latte'}


{block topMenuISAdditional}
    {* Navigation links for the IS Tasks dashboard and current page *}
    <a href="{link :IS:Tasks:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Úkony
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Potvrdit sklizeň
    </a>
{/block topMenuISAdditional}

{block isMainPanel}
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-clipboard-check me-2"></i>Dokončení sklizně
                    </h4>
                </div>

                <div class="card-body p-4">
                    {* Display information about the current harvest *}
                    <div class="alert alert-info mb-4">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-info-circle me-2"></i>Informace o sklizni
                        </h6>
                        <div class="mb-1">
                            <strong>Vinohrad:</strong> {$harvest->getVineyard()->getName()}
                        </div>
                        <div class="mb-1">
                            <strong>Odrůda:</strong> {$harvest->getWineVariety()->getName()}
                        </div>
                        <div class="mb-1">
                            <strong>Termín plánovaný:</strong> {$harvest->getPlannedTimestamp()->format('d.m.Y H:i')}
                        </div>
                        <div>
                            <strong>Termín dokončení:</strong> {$harvest->getExecutionTimestamp()->format('d.m.Y H:i')}
                        </div>
                    </div>

                    {* Form for marking the harvest as done *}
                    {form markHarvestDoneForm}
                        <div class="mb-3">
                            <label for="quantity" class="form-label fw-semibold">
                                <i class="fas fa-weight-hanging me-2 text-muted"></i>{label quantity /}
                                <span class="text-danger">*</span>
                            </label>
                            {input quantity}
                            <span class="invalid-feedback">
                                {inputError quantity}
                            </span>
                        </div>

                        <div class="mb-3">
                            <label for="sugar_content" class="form-label fw-semibold">
                                <i class="fas fa-flask me-2 text-muted"></i>{label sugar_content /}
                                <span class="text-danger">*</span>
                            </label>
                            {input sugar_content}
                            <span class="invalid-feedback">
                                {inputError sugar_content}
                            </span>
                        </div>

                        {* Action buttons: back to tasks or submit the form *}
                        <div class="border-top pt-4">
                            <div class="row">
                                <div class="col-12 col-md-6 mb-3 mb-md-0">
                                    <a href="{link Tasks:dashboard}" class="btn btn-outline-secondary w-100 fw-bold">
                                        <i class="fas fa-arrow-left me-2"></i>Zpět na úkony
                                    </a>
                                </div>
                                <div class="col-12 col-md-6">
                                    {input send}
                                </div>
                            </div>
                        </div>
                    {/form}
                </div>
            </div>
        </div>
    </div>
{/block isMainPanel}