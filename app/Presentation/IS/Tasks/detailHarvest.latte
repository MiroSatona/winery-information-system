{*
FILE:     detailHarvest.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for displaying detailed information about harvest task
*}

{layout '../isLayout.latte'}

{block topMenuISAdditional}
    {* Navigation links for the IS Tasks dashboard and current harvest details *}
    <a href="{link :IS:Tasks:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Úkony
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Detaily o sklizni
    </a>
{/block topMenuISAdditional}

{block isMainPanel}
    {* Header for the harvest task detail, includes task info *}
    {include 'detailHeader.latte', task: $task}

    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header text-dark p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h5 class="mb-0 fw-bold">
                                <i class="fas fa-leaf me-2"></i>Specifické informace o sklizni
                            </h5>

                            <div class="d-flex gap-2 flex-wrap">
                                {* Link to the vineyard detail *}
                                <a href="{link :IS:Vineyards:show vineyardId => $task->getVineyard()->getId()}" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-map-marker-alt me-1"></i>{$task->getVineyard()->getName()}
                                </a>
                                {* Link to the wine variety edit page *}
                                <a href="{link :IS:WineVarieties:edit id => $task->getWineVariety()->getId()}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-wine-glass me-1"></i>{$task->getWineVariety()->getName()}
                                </a>
                                {* Link to the produced wine detail, if available *}
                                {if $wine}
                                    <a href="{link :IS:Wine:show $wine->getId()}" class="btn btn-sm btn-primary">
                                        <i class="fas fa-wine-bottle me-1"></i>{$wine->getName()}
                                    </a>
                                {/if}
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-12 col-md-8">
                                <div class="mb-4">
                                    {* Vineyard and wine variety info *}
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-map-marker-alt me-2"></i>Vinohrad
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$task->getVineyard()->getName()}</p>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-wine-glass me-2"></i>Odrůda vína
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$task->getWineVariety()->getName()}</p>
                                        </div>
                                    </div>

                                    {* Weight and sugar content info *}
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-weight me-2"></i>Hmotnost
                                            </label>
                                            <p class="fs-6 text-dark mb-2">
                                                {if $task->getWeight()}
                                                    {$task->getWeight()} kg
                                                {else}
                                                    <span class="text-muted fst-italic">Nezadáno</span>
                                                {/if}
                                            </p>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-cube me-2"></i>Obsah cukru
                                            </label>
                                            <p class="fs-6 text-dark mb-2">
                                                {if $task->getSugarContent()}
                                                    {$task->getSugarContent()} °NM
                                                {else}
                                                    <span class="text-muted fst-italic">Nezměřeno</span>
                                                {/if}
                                            </p>
                                        </div>
                                    </div>

                                    {* Confirmer and produced wine info *}
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-user-check me-2"></i>Potvrdil vinař
                                            </label>
                                            <p class="fs-6 text-dark mb-2">
                                                {if $harvestConfirmer}
                                                    {$harvestConfirmer->getFullName()}
                                                {else}
                                                    <span class="text-muted fst-italic">Nepotvrzeno</span>
                                                {/if}
                                            </p>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-wine-bottle me-2"></i>Vyrobené víno
                                            </label>
                                            <p class="fs-6 text-dark mb-2">
                                                {if $wine}
                                                    {$wine->getName()}
                                                {else}
                                                    <span class="text-muted fst-italic">Zatím nezpracováno</span>
                                                {/if}
                                            </p>
                                        </div>
                                    </div>

                                    {* List of harvested rows, with add form if task is planned *}
                                    <div class="row mt-4">
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h5 class="fw-semibold text-muted mb-0">
                                                    <i class="fas fa-list me-2"></i>Sklizené řádky
                                                </h5>

                                                {* Show add row form only if task is in PLANNED state *}
                                                {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                    {form addRowForm}
                                                        <div class="d-flex align-items-end gap-2">
                                                            {input rowCode}
                                                            {input send}
                                                        </div>
                                                    {/form}
                                                {/if}
                                            </div>

                                            {if $wineRows}
                                                <div class="table-responsive">
                                                    <table class="table table-primary">
                                                        <thead>
                                                            <tr>
                                                                <th><i class="fas fa-hashtag me-2"></i>Kód řádku</th>
                                                                <th><i class="fas fa-seedling me-2"></i>Počet keřů</th>
                                                                <th><i class="fas fa-calendar-alt me-2"></i>Rok výsadby</th>
                                                                <th><i class="fas fa-check-circle me-2"></i>Aktivní</th>
                                                                {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                                    <th><i class="fas fa-cog me-2"></i>Akce</th>
                                                                {/if}
                                                            </tr>
                                                        </thead>
                                                        {* Show warning if there are rows in conflict with spraying *}
                                                        {if $task->isInConflict()}
                                                            <div class="text-danger mt-2 mb-1">
                                                                <i class="fas fa-exclamation-triangle ms-2"></i>
                                                                Řádky označené červeně jsou v konfliktu s ošetřením (méně než 14 dní mezi sklizní a ošetřením).
                                                            </div>
                                                        {/if}
                                                        <tbody>
                                                            {foreach $wineRows as $wineRow}
                                                                <tr class="{if $wineRow->isInConflict()} 
                                                                                table-danger text-white 
                                                                            {else} 
                                                                                table-light text-dark 
                                                                            {/if}">
                                                                    <td><strong>{$wineRow->getId()}</strong></td>
                                                                    <td>{$wineRow->getHeadCount()}</td>
                                                                    <td>{$wineRow->getYearPlanted()}</td>
                                                                    <td>
                                                                        {if $wineRow->isActive()}
                                                                            <span class="badge bg-success">Ano</span>
                                                                        {else}
                                                                            <span class="badge bg-danger">Ne</span>
                                                                        {/if}
                                                                    </td>

                                                                    {* Show delete button for rows if task is planned *}
                                                                    {if $userVintner && $task->getState() === App\Model\Task\TaskState::PLANNED}
                                                                        <td class="text-center">
                                                                            <a n:href="deleteTaskRows! $wineRow->getId()"
                                                                            class="btn btn-sm btn-outline-danger">
                                                                                <i class="fas fa-minus me-1"></i>Odebrat
                                                                            </a>
                                                                        </td>
                                                                    {/if}
                                                                </tr>
                                                            {/foreach}
                                                        </tbody>

                                                    </table>
                                                </div>
                                            {else}
                                                <p class="text-muted">No vineyard rows are assigned.</p>
                                            {/if}
                                        </div>
                                    </div>
                                </div>  
                            </div>      
                        </div>          
                    </div>              
                </div>                  
            </div>                      
        </div>                          
    </div>                              
{/block isMainPanel}
