
<!--
//FILE:     selling.latte
//AUTHORS:  Martin Zůbek [C]
//          Otakar Kočí
//          Martin Mendl
//YEAR:     2025
//DESC:     latte template for selling wine (add wine to sale)
-->
{layout '../isLayout.latte'}


{* Top menu navigation for wine dashboard and selling page *}
{block topMenuISAdditional}
    <a href="{link :IS:Wine:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vína
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Zařazení do prodeje
    </a>
{/block topMenuISAdditional}


{* Main panel for selling wine (add wine to sale) *}
{block isMainPanel}
<div class="d-flex justify-content-center align-items-center h-100">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="fas fa-wine-glass me-2"></i>
                    Zařazení vína do prodeje
                </h4>
            </div>

            <div class="card-body p-4">
                {* Wine information card *}
                <div class="mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light py-3">
                            <h5 class="mb-0 fw-bold text-primary">
                                <i class="fas fa-wine-glass me-2"></i>{$wine->name}
                            </h5>
                        </div>
                        <div class="card-body p-3 text-center">
                            <div class="current-image-container">
                                {if $wine->img !== null}
                                    {* Show wine image if available *}
                                    <img src="{asset $imageRepository->getPathForImage($wine->img)}"
                                         alt="{$wine->name}" 
                                         class="img-fluid rounded shadow-sm"
                                         style="max-height: 200px; object-fit: cover;">
                                {else}
                                    {* Placeholder if no image is available *}
                                    <div class="no-image-placeholder d-flex justify-content-center align-items-center bg-light border rounded"
                                         style="height: 200px;">
                                        <i class="fas fa-wine-bottle fa-4x text-muted"></i>
                                    </div>
                                {/if}
                            </div>
                        </div>
                    </div>
                </div>

                {* Form for setting wine price and description *}
                {form setWinePriceForm}
                    <div class="mb-3">
                        <label for="price" class="form-label fw-semibold">
                            <i class="fas fa-coins me-2 text-muted"></i>{label price /}
                            <span class="text-danger">*</span>
                        </label>
                        {input price}
                        <span class="invalid-feedback">
                            {inputError price}
                        </span>
                    </div>

                    <hr class="my-4">

                    {* Product description input *}
                    <div class="mb-4">
                        <label for="popis" class="form-label fw-semibold">
                            <i class="fas fa-file-alt me-2 text-muted"></i>{label popis /}
                            <span class="text-danger">*</span>
                        </label>
                        {input popis}
                        <span class="invalid-feedback">
                            {inputError popis}
                        </span>
                    </div>

                    {* Info alert about the process *}
                    <div class="alert alert-info mb-4">
                        <h6 class="fw-bold mb-2">
                            <i class="fas fa-info-circle me-2"></i>Informace
                        </h6>
                        <small class="mb-0">
                            Po potvrzení bude víno zařazeno do e-shopu s uvedenou cenou a popisem. Tyto údaje můžete později upravit v detailu vína.
                        </small>
                    </div>

                    <div class="border-top pt-4">
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3 mb-md-0">
                                {* Cancel button returns to dashboard *}
                                <a href="{link Wine:dashboard}" class="btn btn-outline-secondary w-100 fw-bold">
                                    <i class="fas fa-times me-2"></i>Zrušit
                                </a>
                            </div>
                            <div class="col-12 col-md-6">
                                {* Submit button to add wine to sale *}
                                {input send, class => 'btn btn-primary w-100 fw-bold'}
                                <span class="invalid-feedback">
                                    {inputError send}
                                </span>
                            </div>
                        </div>
                    </div>
                {/form}
            </div>
        </div>
    </div>
</div>
{/block isMainPanel}
