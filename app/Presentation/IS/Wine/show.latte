
<!--
//FILE:     show.latte
//AUTHORS:  Martin Zůbek [C]
//          Otakar Kočí
//          Martin Mendl
//YEAR:     2025
//DESC:     Latte template for displaying wine detail in IS
-->
{layout '../isLayout.latte'}

{block topMenuISAdditional}
    {* Top navigation menu for wine detail page *}
    <a href="{link :IS:Wine:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vína
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Detail vína
    </a>
{/block topMenuISAdditional}

{block isMainPanel}
    {* Main content panel for wine detail *}
    <div class="container-fluid">
        {* Main wine details section *}
        <div class="row mb-4">
            {* Section: Wine detail card with actions and info *}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold">
                                <i class="fas fa-wine-glass me-2"></i>
                                Detail vína
                            </h4>
                            <div class="d-flex gap-2">
                                {* Action buttons for wine management, shown based on wine state and user role *}
                                <a href="{link Wine:dashboard}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-arrow-left me-2"></i>Zpět na přehled
                                </a>
                                {if $wine->getState() === $WineState::PRODUCTION && $userVintner}
                                    <button type="button" 
                                            class="btn btn-danger btn-sm" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#liquidateModal{$wine->getId()}"
                                            title="Zlikvidovat víno">
                                        <i class="fas fa-trash me-2"></i>Zlikvidovat víno
                                    </button>
                                {/if}
                                {if $wine->getState() === $WineState::PRODUCTION && $userVintner}
                                    {if $unfinishedBottlingTask === null}
                                        <a href="{link :IS:Tasks:startBottling, $wine->getId()}" class="btn btn-primary btn-sm">
                                            <i class="fas fa-wine-bottle me-2"></i>Zalahvovat víno
                                        </a>
                                    {else}
                                        <a href="{link :IS:Tasks:markTaskDone, $unfinishedBottlingTask->getId()}" class="btn btn-primary btn-sm">
                                            <i class="fas fa-wine-bottle me-2"></i>Dokončit lahvování
                                        </a>
                                    {/if}
                                {/if}
                                {if $wine->getState() === $WineState::BOTTLED && $userVintner}
                                    <a href="{link selling $wine->getId()}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-coins me-2"></i>Zařadit do prodeje
                                    </a>
                                {/if}
                                {if $wine->getState() === $WineState::SALE && $userVintner}
                                    <a href="{link changePrice $wine->getId()}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-coins me-2"></i>Změnit cenu
                                    </a>
                                {/if}
                                {if $wine->getState() === $WineState::PRODUCTION && $userVintner}
                                    <a href="{link edit $wine->getId()}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-edit me-2"></i>Upravit víno
                                    </a>
                                {/if}
                                {if ($wine->getState() === $WineState::SALE || $wine->getState() === $WineState::BOTTLED) && $userVintner}
                                    <a href="{link changeImage $wine->getId()}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-image me-2"></i>Změna obrázku
                                    </a>
                                {/if}
                                
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row">
                            {* Two-column layout: wine info and wine image *}
                            {* Wine information *}
                            <div class="col-12 col-md-8">
                                {* Left column: wine attributes and details *}
                                <div class="mb-4">
                                    <div class="row mb-3">
                                        {* Wine name and state *}
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-wine-glass me-2"></i>Název vína
                                            </label>
                                            <p class="fs-4 fw-bold text-dark mb-2">{$wine->getName()}</p>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-info-circle me-2"></i>Stav
                                            </label>
                                            <p class="fs-4 fw-bold text-dark mb-2">{$wine->getStateText()}</p>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        {* Wine year and volume *}
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-calendar-alt me-2"></i>Ročník
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getYear()}</p>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-flask me-2"></i>Objem
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getVolume()} l</p>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        {* Wine type and color *}
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-tint me-2"></i>Typ
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getTypeText()}</p>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-palette me-2"></i>Barva
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getColorText()}</p>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        {* Wine grade and bottles left (if bottled/sale/sold) *}
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-award me-2"></i>Přívlastek
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getGradeText()}</p>
                                        </div>
                                        {if $wine->getState() === $WineState::BOTTLED || $wine->getState() === $WineState::SALE || $wine->getState() === $WineState::SOLD}
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold text-muted">
                                                    <i class="fas fa-wine-bottle me-2"></i>Zbývá lahví
                                                </label>
                                                <p class="fs-6 text-dark mb-2">{$wine->getBottlesLeft()}</p>
                                            </div>
                                        {/if}
                                    </div>

                                    {if $wine->getState() === $WineState::SALE || $wine->getState() === $WineState::SOLD}
                                        {* Show current and original price if available *}
                                        <div class="row mb-3">
                                            {if $wine->getCurrentPrice() !== null}
                                                <div class="col-md-6">
                                                    <label class="form-label fw-semibold text-muted">
                                                        <i class="fas fa-tag me-2"></i>Aktuální cena
                                                    </label>
                                                    <p class="fs-6 text-dark mb-2 fw-bold">{$wine->getCurrentPrice()} Kč</p>
                                                </div>
                                            {/if}
                                            {if $wine->getBottlePrice() !== null}
                                                <div class="col-md-6">
                                                    <label class="form-label fw-semibold text-muted">
                                                        <i class="fas fa-money-bill me-2"></i>Původní cena láhve
                                                    </label>
                                                    <p class="fs-6 text-dark mb-2">{$wine->getBottlePrice()} Kč</p>
                                                </div>
                                            {/if}
                                        </div>
                                    {/if}

                                    {if $wine->getState() === $WineState::BOTTLED || $wine->getState() === $WineState::SALE || $wine->getState() === $WineState::SOLD}
                                        {* Show total bottles produced and bottle volume *}
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold text-muted">
                                                    <i class="fas fa-wine-bottle me-2"></i>Lahví vyrobeno
                                                </label>
                                                <p class="fs-6 text-dark mb-2">{$wine->getBottlesTotal()}</p>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold text-muted">
                                                    <i class="fas fa-flask me-2"></i>Objem láhve
                                                </label>
                                                <p class="fs-6 text-dark mb-2">{$wine->getBottleVolume()} l</p>
                                            </div>
                                        </div>
                                    {/if}

                                    
                                    
                                    {if $wine->getLeftSugar() !== null || $wine->getAcidContents() !== null}
                                        {* Show left sugar and acid content if available *}
                                        <div class="row mb-3">
                                            {if $wine->getLeftSugar() !== null}
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold text-muted">
                                                        <i class="fas fa-cube me-2"></i>Zbytkový cukr
                                                    </label>
                                                    <p class="fs-6 text-dark mb-0">{$wine->getLeftSugar()} g/l</p>
                                                </div>
                                            {/if}
                                            {if $wine->getAcidContents() !== null}
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label fw-semibold text-muted">
                                                        <i class="fas fa-vial me-2"></i>Obsah kyselin
                                                    </label>
                                                    <p class="fs-6 text-dark mb-0">{$wine->getAcidContents()} g/l</p>
                                                </div>
                                            {/if}
                                        </div>
                                    {/if}
                                    <div class="row mb-3">
                                        {* Alcohol percentage *}
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-percentage me-2"></i>Obsah alkoholu
                                            </label>
                                            <p class="fs-6 text-dark mb-2">{$wine->getAlcoholPercentage()}%</p>
                                        </div>
                                    </div>

                                    <hr>

                                    {if $wine->getSalesDescription()}
                                        {* Sales description if available *}
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold text-muted">
                                                <i class="fas fa-align-left me-2"></i>Prodejní popis
                                            </label>
                                            <p class="text-dark mb-2">{$wine->getSalesDescription()}</p>
                                        </div>
                                    {/if}

                                    <div class="mb-3">
                                        {* Production note *}
                                        <label class="form-label fw-semibold text-muted">
                                            <i class="fas fa-clipboard me-2"></i>Poznámka z výroby
                                        </label>
                                        <p class="text-dark mb-2">{$wine->getProductionNote()}</p>
                                    </div>
                                </div>
                            </div>

                            {* Wine image *}
                            <div class="col-12 col-md-4">
                                {* Right column: wine image or placeholder *}
                                <div class="wine-image-container border rounded p-3 bg-light d-flex justify-content-center">
                                    {if $wine->getImage()}
                                        <img src="{asset $imageRepository->getPathForImage($wine->getImage())}" 
                                             alt="{$wine->getImage()->description}" 
                                             class="rounded shadow-sm"
                                             style="max-width: 100%; object-fit: contain;">
                                    {else}
                                        <div class="no-image-placeholder text-center py-5">
                                            <i class="fas fa-wine-bottle fa-4x text-muted mb-3"></i>
                                            <p class="text-muted mb-0">Bez obrázku</p>
                                        </div>
                                    {/if}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {* Wine varieties section *}
        <div class="row mb-4">
            {* Section: Wine varieties *}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white text-dark py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">
                                <i class="fas fa-seedling me-2"></i>Odrůdy vína
                            </h5>
                            <a href="{link :IS:WineVarieties:dashboard}" class="btn btn-primary btn-sm">
                                <i class="fas fa-seedling me-2"></i>Přehled odrůd
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        {if count($wine->getVarieties()) > 0}
                            {* Table of wine varieties *}
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-primary">
                                        <tr>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-seedling me-2"></i>Název
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-palette me-2"></i>Barva
                                            </th>
                                            <th scope="col" class="fw-bold">
                                                <i class="fas fa-align-left me-2"></i>Popis
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $wine->getVarieties() as $variety}
                                            {* Each variety row *}
                                            <tr class="align-middle">
                                                <td>
                                                    <h6 class="mb-0 fw-semibold text-dark">{$variety->getName()}</h6>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">
                                                        {switch $variety->getColor()}
                                                            {case $WineVarietyType::WHITE}
                                                                Bílé
                                                            {case $WineVarietyType::RED}
                                                                Červené
                                                            {case $WineVarietyType::PINK}
                                                                Růžové
                                                            {case $WineVarietyType::GREY}
                                                                Šedé
                                                            {case $WineVarietyType::BLUE}
                                                                Modré
                                                        {/switch}
                                                    </span>
                                                </td>
                                                <td>
                                                    <p class="mb-0 text-muted">
                                                        {if strlen($variety->getDescription()) > 120}
                                                            {$variety->getDescription()|truncate:120}
                                                        {else}
                                                            {$variety->getDescription()}
                                                        {/if}
                                                    </p>
                                                </td>
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            </div>
                        {else}
                            {* No varieties assigned message *}
                            <div class="text-center py-5">
                                <i class="fas fa-seedling fa-3x text-muted mb-3 opacity-50"></i>
                                <h5 class="text-muted">Žádné odrůdy vína</h5>
                                <p class="text-muted">K tomuto vínu nejsou přiřazeny žádné odrůdy.</p>
                            </div>
                        {/if}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {* Liquidation confirmation modal for wine in production *}
    {if $wine->getState() === $WineState::PRODUCTION && $userVintner}
        <div class="modal fade" id="liquidateModal{$wine->getId()}" tabindex="-1" aria-labelledby="liquidateModalLabel{$wine->getId()}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="liquidateModalLabel{$wine->getId()}">
                            <i class="fas fa-exclamation-triangle me-2"></i>Potvrdit likvidaci vína
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fas fa-wine-glass fa-3x text-danger mb-3"></i>
                            <h5>Opravdu chcete zlikvidovat toto víno?</h5>
                            <div class="mt-3 p-3 bg-light rounded">
                                <p class="mb-1 fw-semibold">{$wine->getName()}</p>
                                <p class="mb-1"><strong>Ročník:</strong> {$wine->getYear()}</p>
                                <p class="mb-1"><strong>Typ:</strong> 
                                    {if $wine->getType() === 'DRY'}Suché
                                    {elseif $wine->getType() === 'HALF_DRY'}Polosuché 
                                    {elseif $wine->getType() === 'HALF_SWEET'}Polosladké
                                    {else}Sladké{/if}
                                </p>
                                <p class="mb-0"><strong>Objem:</strong> {$wine->getVolume()} l</p>
                            </div>
                            <div class="alert alert-info mt-3 mb-0 text-start">
                                <i class="fas fa-info-circle me-2"></i>Informace
                                <p>
                                Likvidace vína je nevratná operace. Víno bude označeno jako zlikvidované a nebude možné ho dále používat v produkci.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Zrušit
                        </button>
                        <a href="{link liquidate!, $wine->getId()}" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Zlikvidovat víno
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {/if}

{/block isMainPanel}