{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <a href="{link :IS:Wine:dashboard}" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vína
    </a>
    <a href="#" class="nav-link nav-button py-2 fw-bold fs-5">
        <i class="fas fa-arrow-right me-2"></i>Vyrobit víno
    </a>
{/block topMenuISAdditional}

{block isMainPanel}
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-wine-bottle me-2"></i>
                        Krok 2: Výroba vína z vybraných sklizní
                    </h4>
                </div>
                <div class="card-body p-4">
                    {* Selected harvests summary *}
                    <div class="mb-4">
                            <h5 class="fw-bold mb-4 text-primary">
                                <i class="fas fa-seedling me-2"></i>
                                Vybrané sklizně
                            </h5>
                                {if count($harvestsInProduction) > 0}
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col" class="fw-bold">
                                                        <i class="fas fa-seedling me-2"></i>Odrůda
                                                    </th>
                                                    <th scope="col" class="fw-bold">
                                                        <i class="fas fa-mountain me-2"></i>Vinohrad
                                                    </th>
                                                    <th scope="col" class="fw-bold text-center">
                                                        <i class="fas fa-calendar-alt me-2"></i>Datum sklizně
                                                    </th>
                                                    <th scope="col" class="fw-bold text-center">
                                                        <i class="fas fa-weight-hanging me-2"></i>Hmotnost
                                                    </th>
                                                    <th scope="col" class="fw-bold text-center">
                                                        <i class="fas fa-tint me-2"></i>Cukr
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {foreach $harvestsInProduction as $harvest}
                                                    <tr class="align-middle">
                                                        <td class="fw-semibold">
                                                            {$harvest->getWineVariety()->getName()}
                                                        </td>
                                                        <td class="fw-semibold">
                                                            {$harvest->getVineyard()->getName()}
                                                        </td>
                                                        <td class="fw-semibold text-center">
                                                            {$harvest->getExecutionTimestamp()->format('d.m.Y')}
                                                        </td>
                                                        <td class="fw-semibold text-center">
                                                            {$harvest->getWeight()} kg
                                                        </td>
                                                        <td class="fw-semibold text-center">
                                                            {$harvest->getSugarContent()} °NM
                                                        </td>
                                                    </tr>
                                                {/foreach}
                                            </tbody>
                                        </table>
                                    </div>
                                {else}
                                    <div class="p-4">
                                        <div class="alert alert-warning mb-0">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            Žádné sklizně nevybrány. <a href="{link produceP1}" class="alert-link">Přejděte na krok 1</a> pro výběr sklizní.
                                        </div>
                                    </div>
                                {/if}
                    </div>

                    {* Wine production form *}
                    <div>
                        {form produceWineForm}
                            <h5 class="fw-bold mb-4 text-primary">
                                <i class="fas fa-cogs me-2"></i>
                                Parametry vína
                            </h5>

                            <div class="row">
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="name" class="form-label fw-semibold">
                                            <i class="fas fa-tag me-2 text-muted"></i>{label name /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input name}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="year" class="form-label fw-semibold">
                                            <i class="fas fa-calendar-alt me-2 text-muted"></i>{label year /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input year}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="volume" class="form-label fw-semibold">
                                            <i class="fas fa-flask me-2 text-muted"></i>{label volume /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input volume}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="type" class="form-label fw-semibold">
                                            <i class="fas fa-wine-glass me-2 text-muted"></i>{label type /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input type}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="color" class="form-label fw-semibold">
                                            <i class="fas fa-palette me-2 text-muted"></i>{label color /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input color}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="grade" class="form-label fw-semibold">
                                            <i class="fas fa-award me-2 text-muted"></i>{label grade /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input grade}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="alcoholPercentage" class="form-label fw-semibold">
                                            <i class="fas fa-percentage me-2 text-muted"></i>{label alcoholPercentage /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input alcoholPercentage}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="leftSugar" class="form-label fw-semibold">
                                            <i class="fas fa-cube me-2 text-muted"></i>{label leftSugar /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input leftSugar}
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="mb-3">
                                        <label for="acidContents" class="form-label fw-semibold">
                                            <i class="fas fa-vial me-2 text-muted"></i>{label acidContents /}
                                            <span class="text-danger">*</span>
                                        </label>
                                        {input acidContents}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                
                            </div>

                            <div class="mb-4">
                                <label for="productionNote" class="form-label fw-semibold">
                                    <i class="fas fa-sticky-note me-2 text-muted"></i>{label productionNote /}
                                </label>
                                {input productionNote}
                            </div>

                            {* Action buttons *}
                            <div class="border-top pt-4">
                                <div class="row g-2">
                                    <div class="col-4">
                                        {input backToDashboard}
                                    </div>
                                    <div class="col-4">
                                        {input back}
                                    </div>
                                    <div class="col-4">
                                        {input produce}
                                    </div>
                                </div>
                            </div>
                        {/form}
                    </div>
                </div>
            </div>
        </div>
    </div>

{/block isMainPanel}