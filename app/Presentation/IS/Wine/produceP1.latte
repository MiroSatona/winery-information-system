{layout '../isLayout.latte'}

{block topMenuISAdditional}
    <i class="fas fa-arrow-right me-2"></i>Vína
    <i class="fas fa-arrow-right me-2"></i>Vyrobit víno
{/block topMenuISAdditional}

{block isMainPanel}

<h5>Krok 1: Výběr sklizní pro výrobu vína</h5>
    {form harvestSelectionForm}


        {label harvest /}
        {input harvest}

        <h5>Vybrané sklizně pro výrobu vína:</h5>
        {foreach $harvestsInProduction as $harvest}
            <p>
                {$harvest->getWineVariety()->getName()} - 
                {$harvest->getVineyard()->getName()} - 
                {$harvest->getExecutionTimestamp()->format('d.m.Y')} - 
                {$harvest->getWeight()} kg - 
                {$harvest->getSugarContent()} °NM
                <a href="{link removeHarvestFromProduction! $harvest->getId()}" class="btn btn-sm btn-outline-danger ms-3">
                    <i class="fas fa-trash-alt me-1"></i>Odebrat
                </a>
            </p>
        {/foreach}

        {input backToDashboard}
        {input addHarvest}
        {input toStep2}

    {/form}

    <h5>Vybrané sklizně pro výrobu vína:</h5>
    {foreach $harvestsInProduction as $harvest}
        <p>
            {$harvest->getWineVariety()->getName()} - 
            {$harvest->getVineyard()->getName()} - 
            {$harvest->getExecutionTimestamp()->format('d.m.Y')} - 
            {$harvest->getWeight()} kg - 
            {$harvest->getSugarContent()} °NM
            <a href="{link removeHarvestFromProduction! $harvest->getId()}" class="btn btn-sm btn-outline-danger ms-3">
                <i class="fas fa-trash-alt me-1"></i>Odebrat
            </a>
        </p>
    {/foreach}


{/block isMainPanel}