{block content}
<h1 class="wine-title">{$wine->name}</h1>

<div class="wine-detail-container">
    <div class="wine-image">
        <img src="{$wine->img->src}" alt="{$wine->img->description}">
    </div>

    <div class="wine-info">
        <h2 class="wine-info-title">Wine Details</h2>
        <ul class="wine-specs">
            <li><strong>Year:</strong> {$wine->year}</li>
            <li><strong>Type:</strong> {$wine->type}</li>
            <li><strong>Color:</strong> {$wine->color}</li>
            <li><strong>Grade:</strong> {$wine->grade}</li>
            <li><strong>Alcohol:</strong> {$wine->alcoholPercentage}%</li>
            <li><strong>Volume:</strong> {$wine->volume} ml</li>
        </ul>

        <div class="wine-price-section">
            {ifset $wine->currentPrice}
                <p class="wine-price">{$wine->currentPrice} €</p>
            {else}
                <p class="wine-price na">Price N/A</p>
            {/ifset}
            <button class="btn-add-cart">Add to Cart</button>
        </div>

        {ifset $wine->salesDescription}
            <p class="wine-description">{$wine->salesDescription}</p>
        {/ifset}

        <a n:href="Shop:default" class="back-link">← Back to Wine List</a>
    </div>
</div>

<style>
/* Layout */
.wine-detail-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    max-width: 1000px;
    margin: 3rem auto;
    padding: 2rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
}

/* Title */
.wine-title {
    text-align: center;
    font-size: 2.5rem;
    color: #4a2c2a;
    font-weight: 600;
    margin-top: 2rem;
}

/* Image */
.wine-image img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

/* Info section */
.wine-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.wine-info-title {
    font-size: 1.5rem;
    color: #4a2c2a;
    font-weight: 500;
    margin-bottom: 0.5rem;
}

.wine-specs {
    list-style: none;
    padding: 0;
    margin: 0;
    line-height: 1.8;
    color: #444;
    font-size: 1rem;
}

/* Price & Button */
.wine-price-section {
    margin-top: 1.5rem;
}

.wine-price {
    font-size: 1.8rem;
    font-weight: 600;
    color: #7a1c1c;
    margin-bottom: 1rem;
}

.wine-price.na {
    color: #999;
}

.btn-add-cart {
    background: #7a1c1c;
    color: #fff;
    border: none;
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s ease;
}

.btn-add-cart:hover {
    background: #631414;
    transform: translateY(-2px);
}

/* Description */
.wine-description {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
}

/* Back link */
.back-link {
    display: inline-block;
    margin-top: 2rem;
    color: #4a2c2a;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
}

.back-link:hover {
    color: #7a1c1c;
}

/* Responsive */
@media (max-width: 800px) {
    .wine-detail-container {
        grid-template-columns: 1fr;
        padding: 1.5rem;
    }
}
</style>
{/block}

{block specializedFooter}

{/block specializedFooter}