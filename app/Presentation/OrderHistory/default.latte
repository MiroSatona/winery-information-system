{block content}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fa-solid fa-receipt me-2"></i>Historie objednávek
        </h2>
        <a n:href=":Cart:default" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrow-left me-1"></i> Zpět do košíku
        </a>
    </div>
    {if $message}
        <div class="alert alert-info text-center py-3">
            <i class="fa-solid fa-circle-info me-2"></i>{$message}
        </div>
    {else}
        <div class="row gy-4">
            {foreach $orders as $order}
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
                                <div>
                                    <h5 class="card-title mb-0">
                                        <i class="fa-solid fa-box me-2 text-primary"></i>
                                        Číslo objednávky: {$order->id}
                                    </h5>
                                    <small class="text-muted">
                                        <i class="fa-regular fa-calendar-days me-1"></i>
                                        {$order->orderTimestamp|date:'d.m.Y H:i'}
                                    </small>
                                </div>
                                <div>
                                    {switch $order->state}
                                        {case $OrderState::RESERVED->value}
                                            <span class="badge bg-warning text-dark">
                                                <i class="fa-solid fa-clock me-1"></i> Rezervováno
                                            </span>
                                        {case $OrderState::PAID->value}
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-check me-1"></i> Zaplaceno
                                            </span>
                                        {case $OrderState::CANCELLED->value}
                                            <span class="badge bg-danger">
                                                <i class="fa-solid fa-xmark me-1"></i> Zrušeno
                                            </span>
                                        {case $OrderState::DELIVERED->value}
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-check me-1"></i> Odesláno
                                            </span>
                                        {default}
                                            <span class="badge bg-secondary">
                                                <i class="fa-solid fa-question me-1"></i> Neznámý stav
                                            </span>
                                    {/switch}
                                </div>
                            </div>

                            <hr class="my-3">

                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1">
                                        <strong><i class="fa-solid fa-truck me-1"></i>Doručení:</strong>
                                        {if $order->deliveryType}
                                            {switch $order->deliveryType}
                                                {case 'PICKUP'} Osobní odběr 
                                                {case 'COURIER'} Kurýr 
                                                {case 'POST'} Pošta 
                                                {default} Jiný způsob 
                                            {/switch}
                                        {else}
                                            <span class="text-muted">Nezadáno</span>
                                        {/if}
                                    </p>
                                    <p class="mb-0 text-muted small">
                                        {$order->deliveryData}
                                    </p>
                                </div>

                                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                    <h5 class="mb-1">
                                        <i class="fa-solid fa-money-bill-wave me-1 text-success"></i>
                                        Celkem: <strong>{$order->totalPrice} Kč</strong>
                                    </h5>
                                </div>
                            </div>

                            {if !empty($order->items)}
                                <hr class="my-3">
                                <p class="fw-bold mb-2"><i class="fa-solid fa-wine-bottle me-1"></i>Položky objednávky:</p>
                                <ul class="list-group list-group-flush">
                                    {foreach $order->items as $item}
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>{$item->wine->name}</span>
                                            <span class="text-muted">{$item->bottlesCount}× {$item->pricePerBottle} Kč</span>
                                        </li>
                                    {/foreach}
                                </ul>
                            {/if}
                        </div>
                    </div>
                </div>
            {/foreach}
        </div>
    {/if}
</div>

{/block}
