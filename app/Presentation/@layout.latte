<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<script src="{$basePath}/scripts/main.js"></script>

	{asset 'styles/styles.css'}

	<title>{ifset title}{include title|stripHtml} | {/ifset}Vinařství Andrej</title>
</head>

<body>
	<div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>

	{block topMenuBar}
		<nav class="mainMenu navbar navbar-expand-lg navbar-light bg-light border-bottom position-fixed w-100">
			<div class="container-fluid">
				<!-- LEFT home link-->
				<a href="{link Home:default}" class="text-decoration-none">
					<div class="navbar-brand">
						{block topMenuLeft}
							
							<img src="{asset 'icons/appIcon.jpg'}" class="appIcon" >
							<strong>Vinařství Andrej</strong>
						{/block topMenuLeft}
					</div>
				</a>

				<!-- CENTRE - main navigation -->
				<div class="navbar-nav mx-auto">
					{block topMenuCenter}
						<a href="{link Home:default}" class="nav-link mx-2">Domů</a>
						<a href="{link Shop:default}" class="nav-link mx-2">Obchod</a>
						{if $userWorker || $userVintner || $userAdmin}
							<a href="{link IS:mainDashboard}" class="nav-link mx-2">IS</a>
						{/if}
					{/block topMenuCenter}
				</div>

				<!-- RIGHT - user info and auth -->
				<div class="navbar-nav">
					{block topMenuRight}
						{if $user->isLoggedIn()}
							<div class="nav-item dropdown">
								<a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
									<i class="fas fa-user-circle me-2"></i>
									<span>{$user->getIdentity()->name} {$user->getIdentity()->surname}</span>
								</a>
								<a class="dropdown-item" href="{link Sign:out}"><i class="fas fa-sign-out-alt me-2"></i>Odhlásit se</a>
							</div>
						{else}
							<a href="{link Sign:in}" class="nav-link">
								<i class="fas fa-sign-in-alt me-2"></i>Přihlásit se
							</a>
						{/if}
					{/block topMenuRight}
				</div>
			</div>
		</nav>
	{/block topMenuBar}
	


	<div class="main-content">
		{include content}
	</div>
</body>
</html>
