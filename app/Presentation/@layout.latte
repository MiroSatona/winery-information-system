{*
FILE:     @layout.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     main layout of the website	
*}

<!DOCTYPE html>
<html class="h-100">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<link rel="icon" type="image/jpeg" href="{$basePath}/appIcon.jpg">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

	{asset 'styles/styles.css'}

	{block additionalHeadContent}

	{/block additionalHeadContent}

	<title>{ifset title}{include title|stripHtml} | {/ifset}Vinařství Andrej</title>
</head>

<body class="d-flex flex-column h-100">
	{* Flash messages *}
	<div class="flash-container">
        <div n:foreach="$flashes as $flash" class="flash-message alert-{$flash->type}">
		{switch $flash->type}
			{case 'success'}
				<div class="flash-content">
					<i class="flash-icon fas fa-check-circle"></i>
					<span class="flash-text">{$flash->message}</span>
				</div>
				<button type="button" class="flash-close" onclick="this.parentElement.remove()">
					<i class="fas fa-times"></i>
				</button>

			{case 'error'}
				<div class="flash-content">
					<i class="flash-icon fas fa-exclamation-circle"></i>
					<span class="flash-text">{$flash->message}</span>
				</div>
				<button type="button" class="flash-close" onclick="this.parentElement.remove()">
					<i class="fas fa-times"></i>
				</button>

			{case 'info'}
				<div class="flash-content">
					<i class="flash-icon fas fa-info-circle"></i>
					<span class="flash-text">{$flash->message}</span>
				</div>
				<button type="button" class="flash-close" onclick="this.parentElement.remove()">
					<i class="fas fa-times"></i>
				</button>

			{case 'warning'}
				<div class="flash-content">
					<i class="flash-icon fas fa-exclamation-triangle"></i>
					<span class="flash-text">{$flash->message}</span>
				</div>
				<button type="button" class="flash-close" onclick="this.parentElement.remove()">
					<i class="fas fa-times"></i>
				</button>
		{/switch}
		</div>
    </div>
	
	{* Top menu bar *}
	{block topMenuBar}
		<nav class="mainMenu navbar navbar-expand-lg navbar-light bg-light border-bottom position-fixed w-100 shadow">
			<div class="container-fluid px-4">
				<!-- LEFT home link (app icon) -->
				<a href="{link :Home:default}" class="text-decoration-none">
					<div class="navbar-brand d-flex align-items-center">
						{block topMenuLeft}
							<img src="{asset 'icons/appIcon.png'}" class="appIcon me-3" >
							<strong class="fs-4">Vinařství Andrej</strong>
						{/block topMenuLeft}
					</div>
				</a>

				<!-- Mobile toggle button -->
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
						aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarNav">
					<!-- CENTRE - main navigation -->
					<div class="navbar-nav mx-auto">
						{block topMenuCenter}
							<a href="{link :Home:default}" class="nav-link nav-button mx-2 px-3 py-2 fw-bold fs-5">
								<i class="fas fa-home me-2"></i>Domů
							</a>
							<div class="nav-separator"></div>
							<a href="{link :Shop:default}" class="nav-link nav-button mx-2 px-3 py-2 fw-bold fs-5">
								<i class="fas fa-shopping-cart me-2"></i>Obchod
							</a>
							{if $userWorker || $userVintner || $userAdmin}
								<div class="nav-separator"></div>
								<a href="{link IS:Dashboard:view}" class="nav-link nav-button mx-2 px-3 py-2 fw-bold fs-5">
									<i class="fas fa-cogs me-2"></i>Informační systém
								</a>
							{/if}
						{/block topMenuCenter}
					</div>

					<!-- RIGHT - user info and auth -->
					<div class="navbar-nav">
						{block topMenuRight}
							{if $user->isLoggedIn()}
								<div class="nav-separator me-3"></div>
								<a class="nav-link nav-button auth-button px-3 py-2 fw-bold" href="{link :Profile:default}">
									<i class="fas fa-user-circle me-2"></i> {$user->getIdentity()->name} {$user->getIdentity()->surname}
								</a>
								<a class="nav-link nav-button auth-button px-3 py-2 fw-bold ms-2" href="{link :Sign:out}">
									<i class="fas fa-right-from-bracket me-2"></i>Odhlásit se
								</a>

							{else}
								<div class="nav-separator me-3"></div>
								<a href="{link :Sign:in}" class="nav-link nav-button auth-button mx-1 px-3 py-2 fw-bold">
									<i class="fas fa-right-to-bracket me-2"></i>Přihlásit se
								</a>
								<a href="{link :Sign:up}" class="nav-link nav-button auth-button mx-1 px-3 py-2 fw-bold">
									<i class="fas fa-user-plus me-2"></i>Registrovat se
								</a>
							{/if}
						{/block topMenuRight}
					</div>
				</div>
			</div>
		</nav>
	{/block topMenuBar}
	

	{* Main content area *}
	<div class="main-content flex-grow-1">
		{include content} {* Added in sub templates *}
	</div>

	{* Footer *}
	<footer class="site-footer bg-white border-top py-3 mt-auto">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col-12 text-center">
					{block specializedFooter}
					{* Optional content can be added in sub-templates *}
					{/block specializedFooter}
					{* Motivace *}
					<a href="https://www.youtube.com/watch?v=gOqv-VBrXeA" target="_blank" class="footer-content text-decoration-none" style="color: inherit;">
						<span class="fw-bold fs-6">
							Vinařství Andrej
						</span>
						<span class="text-muted mx-2">|</span>
						<span class="text-muted">© 2025</span>
					</a>
				</div>
			</div>
		</div>
	</footer>
</body>
</html>
