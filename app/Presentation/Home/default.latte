
<!--
//FILE:     default.latte
//AUTHORS:  Martin Zůbek [C]
//          Otakar Kočí
//          Martin Mendl
//YEAR:     2025
//DESC:     Latte template for the home page (winery introduction, vineyards, and wine varieties)
-->

{layout ../@layout.latte}

<!-- Page title block -->
{block title}
    Domů
{/block}



{block content}


    <!-- Main hero section with background image, overlay, and welcome text -->
    <div class="position-relative">
        <!-- Winery background image -->
        <img src="{asset $homeImage}" alt="Home" class="w-100 vh-100 object-fit-cover">
        <!-- Dark overlay for better text readability -->
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
        <!-- Centered welcome text over the image -->
        <div class="position-absolute top-50 start-50 translate-middle">
            <h1 class="text-white display-1 fw-bold">Andrejovo vinařství</h1>
            <p class="text-white text-center display-6">Co je na víně nejlepší? Že s každou skleničkou stárnete a mládnete.</p>
        </div>
    </div>

    <!-- Section: About the winery -->
    <div class="container my-5">
        <div class="row">
                <h2>O nás</h2>
                <p class="fs-5 text-muted">
                    Ahoj jsem Andrej, vítám vás v našem vinařsvtí, o které se staráme po století. 
                    Naše vinařství navazuje na práci našich předků s pokorou a respektem k přírodě. 
                    Každý hrozen zraje na slunci Jižní Moravy, odkud čerpá sílu, chuť i vůni našeho kraje. 
                    Vyrábíme vína s důrazem na poctivost, tradici a kvalitu, přičemž se snažíme zachytit jedinečný charakter každého ročníku. 
                    Každá láhev, kterou držíte v ruce, je výsledkem naší vášně, trpělivosti a rodinného dědictví, které s hrdostí předáváme dál.
                </p>
        </div>
    </div>

    <!-- Section: Vineyards and their wine varieties -->
    <div class="container my-5">
        <!-- Introduction to vineyards section -->
        <div class="row mb-4">
                <h2>Naše vinohrady</h2>
                <p class="fs-5 text-muted"> Prozkoumejte naše vinohrady, objevte jejich jedinečný příběh a odrůdy, které zde pěstujeme.</p>
        </div>
        <!-- List of vineyard cards -->
        <div class="row row-cols-1 g-4">
            {foreach $vineYardsData as $item}
                {var $vineyard = $item['vineyard']}
                {var $image = $vineyard->getImage()}
                {var $varieties = $item['varieties']}

                <div class="col">
                    <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden">
                        <!-- Show vineyard image if available, otherwise show placeholder -->
                        {if $image}
                            <img src="{asset $imageRepository->getPathForImage($image)}" alt="{$image->description}" class="card-img-top" style="object-fit: cover; height: 400px; width: 100%;">
                        {else}
                            <div class="py-5 text-center text-muted">
                                <h4>Žádný obrázek není k dispozici.</h4>
                            </div>
                        {/if}
                        <!-- Card body: vineyard name, description, and varieties -->
                        <div class="card-body py-3">
                            <!-- Vineyard name -->
                            <h3 class="card-title mb-2 fw-bold text-primary">{$vineyard->getName()}</h3>
                            <!-- Vineyard description -->
                            <p class="card-text text-muted mb-4">{$vineyard->getDescription()}</p>
                            <!-- List of wine varieties grown in this vineyard -->
                            <h6 class="fw-semibold">Pěstované odrůdy:</h6>
                            {if $varieties}
                                {foreach $varieties as $variety}
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2 me-2 mb-2">{$variety}</span>
                                {/foreach}
                            {else}
                                <p class="text-muted fst-italic">Žádné odrůdy nejsou evidovány.</p>
                            {/if}
                        </div>
                    </div>
                </div>  
            {/foreach}
        </div>
    </div>

    <!-- Section: Wine varieties overview -->
    <div class="container my-5">
        <!-- Introduction to wine varieties section -->
        <div class="row mb-4">
            <div class="col">
                <h2>Naše odrůdy</h2>
                <p class="fs-5 text-muted">
                    Prozkoumejte naše odrůdy, které pěstujeme v našich vinohradech a objevte jejich jedinečné vlastnosti.
                </p>
            </div>
        </div>

        {if $wineVarietiesData}
            <!-- Cards for each wine variety -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                {foreach $wineVarietiesData as $variety}
                    <div class="col">
                        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden">
                            <!-- Show variety image if available, otherwise show placeholder -->
                            {if $variety->getImage()}
                                <img src="{asset $imageRepository->getPathForImage($variety->getImage())}" alt="{$variety->getImage()->description}" class="card-img-top" style="object-fit: cover; height: 300px; width: 100%;">
                            {else}
                                <div class="bg-light d-flex justify-content-center align-items-center" style="height:300px;">
                                    <span class="text-muted fst-italic">Obrázek se nepodařilo načíst.</span>
                                </div>
                            {/if}
                            <!-- Card body: variety name and description -->
                            <div class="card-body p-3">
                                <!-- Variety name -->
                                <h5 class="card-title mb-1 fw-bold text-primary">{$variety->getName()}</h5>
                                <!-- Variety description -->
                                <p class="card-text text-muted mb-0">{$variety->getDescription()}</p>
                            </div>
                        </div>
                    </div>
                {/foreach}
            </div>
        {else}
            <div class="py-5 text-center text-muted">
                <h4>Žádné odrůdy nejsou evidovány.</h4>
            </div>
        {/if}
    </div>
{/block}
