{block content}

<h1>Your Shopping Cart</h1>

{if $order === null}
    <p>{$message}</p>
{else}
    <div class="cart-items">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Wine</th>
                    <th>Image</th>
                    <th>Quantity</th>
                    <th>Price per Bottle</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {foreach $order->items as $item}
                    <tr>
                        <td>
                            <a class="wine-detail" n:href="Wine:detail $item->wine->id">
                                {$item->wine->name}
                            </a>
                        </td>
                        <td>
                            <img src="{asset $imageRepository->getPathForImage($item->wine->img)}" alt="{$item->wine->img->description}" width="80">
                        </td>
                        <td>
                            {$item->bottlesCount}
                            <a n:href="changeAmount! $item->wine->id, true">+</a>
                            <a n:href="changeAmount! $item->wine->id, false">−</a>
                        </td>
                        <td>{$item->pricePerBottle|number:2} €</td>
                        <td>{($item->pricePerBottle * $item->bottlesCount)|number:2} €</td>
                        <td>
                            <a n:href="removeItem! $item->wine->id" class="btn btn-danger btn-sm">Remove</a>
                        </td>
                    </tr>
                {/foreach}
            </tbody>
        </table>

        <hr>

        <h3>Total price: {$order->totalPrice|number:2} €</h3>

        <!--<a n:href="Checkout:default" class="btn btn-primary">Proceed to Checkout</a>-->
        <a class="btn btn-primary">Proceed to Checkout</a>
    </div>
{/if}

{/block}
