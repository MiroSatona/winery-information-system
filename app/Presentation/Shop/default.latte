{*
FILE:     default.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for wine shop product list (main shop page)
*}
{layout '../@layout.latte'}


{block title}
    Obchod s vínem
{/block}


{block content}

<div class="container my-5">


    <!-- Top navigation and filter/search panel for the wine shop -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border rounded shadow-sm mb-5 px-3 py-2 d-flex align-items-center justify-content-between flex-wrap gap-3">
    <h3 class="fw-bold text-primary mb-0 me-4">
        Naše nabídka vín
    </h3>

    <div class="d-flex align-items-center flex-wrap gap-3 flex-grow-1 justify-content-between">

        <form method="get" class="d-flex align-items-center gap-3 flex-wrap flex-grow-1" id="filterForm">

            <!-- Wine type filter dropdown -->
            <div class="d-flex align-items-center flex-nowrap">
                <label class="me-2 fw-semibold text-secondary white-nowrap" style="min-width: 80px;">
                    Typ vína:
                </label>
                <select class="form-select form-select-sm border-primary text-primary" name="type"
                        onchange="document.getElementById('filterForm').submit();" style="min-width: 120px;">
                    <option value="ALL" n:attr="selected => $type === null">Vše</option>
                    <option value="RED" n:attr="selected => $type === 'RED'">Červené</option>
                    <option value="WHITE" n:attr="selected => $type === 'WHITE'">Bílé</option>
                    <option value="ROSE" n:attr="selected => $type === 'ROSE'">Růžové</option>
                </select>
            </div>

            <!-- Sorting dropdown (by price) -->
            <div class="d-flex align-items-center flex-nowrap">
                <label class="me-2 fw-semibold text-secondary white-nowrap" style="min-width: 70px;">
                    Řazení:
                </label>
                <select class="form-select form-select-sm border-primary text-primary" name="sort"
                        onchange="document.getElementById('filterForm').submit();" style="min-width: 150px;">
                    <option value="">Výchozí</option>
                    <option value="asc" n:attr="selected => $sort === 'asc'">Nejnižší cena první</option>
                    <option value="desc" n:attr="selected => $sort === 'desc'">Nejvyšší cena první</option>
                </select>
            </div>

            <!-- Search input for wine name -->
            <div class="d-flex align-items-center ms-auto">
                <input class="form-control me-2 border-primary" type="search"
                    placeholder="Hledat víno..." name="search" value="{$search ?? ''}">
                <button class="btn btn-outline-primary d-flex align-items-center gap-2" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span class="d-none d-md-inline">Hledat</span>
                </button>
            </div>
        </form>

        <!-- Cart button (link to cart page) -->
        <a n:href=":Cart:default" class="btn btn-primary fw-bold shadow-sm d-flex align-items-center gap-2">
            <i class="fa-solid fa-cart-shopping"></i>
            <span>Košík</span>
        </a>
    </div>
</nav>

    

    <!-- Wine grid: displays all wines as cards -->
    <div class="row g-4">
        {foreach $wines as $wine}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-3 hover-shadow transition">
                    <!-- Link to wine detail page with wine image -->
                    <a n:href="Wine:detail $wine->id" class="text-decoration-none text-dark">
                        <img class="card-img-top rounded-top"
                             src="{if $wine->img}{asset $imageRepository->getPathForImage($wine->img)}{else}{asset 'images/tempWine.jpg'}{/if}"
                             alt="{$wine->img?->description ?? 'Obrázek vína'}"
                             style="aspect-ratio: 3/4; object-fit: cover; background: #f7f9fc;">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <!-- Wine name -->
                        <h5 class="card-title text-center mb-2 text-primary fw-semibold">{$wine->name}</h5>
                        <!-- Stock info -->
                        <p class="text-center text-muted mb-1">
                            <i class="fa-solid fa-box-open me-1 text-secondary"></i>
                            Skladem: <strong>{$wine->bottlesLeft}</strong> lahví
                        </p>
                        <!-- Price info -->
                        <p class="text-center fs-5 text-primary fw-bold mb-3">
                            {ifset $wine->currentPrice}
                                {$wine->currentPrice},-
                            {else}
                                <span class="text-secondary">N/A</span>
                            {/ifset}
                        </p>

                        <div class="mt-auto">
                            {if $userUser}
                                <!-- Add to cart form for logged-in users -->
                                <form n:name="addToCartForm" class="text-center">
                                    <input type="hidden" n:name="wineId" value="{$wine->id}">
                                    <div class="input-group mb-2 justify-content-center">
                                        <input type="number" n:name="count" class="form-control w-50 text-center border-primary"
                                            min="1" max="{$wine->bottlesLeft}" value="1">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                        <i class="fa-solid fa-cart-plus"></i>
                                        <span>Přidat do košíku</span>
                                    </button>
                                </form>
                            {else}
                                <!-- Prompt to sign in for guests -->
                                <div class="text-center">
                                    <a n:href="Sign:in" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                        <i class="fa-solid fa-user"></i>
                                        <span>Přihlásit se pro nákup</span>
                                    </a>
                                </div>
                            {/if}
                        </div>
                    </div>
                </div>
            </div>
        {/foreach}
    </div>

</div>

<!-- Card hover effect for wine cards -->
<style>
    .card:hover {
        transform: translateY(-4px);
        transition: all 0.2s ease-in-out;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    }
</style>
{/block}
