{*
FILE:     edit.latte
AUTHORS:  Martin Zůbek [C]
          Otakar Kočí
          Martin Mendl
YEAR:     2025
DESC:     Latte template for editing user profile and password
*}
{layout ../@layout.latte}

{block title}Editace profilu{/block} <!-- Page title block -->

{block content}
    <!-- Main container for centering the profile edit card -->
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-lg">
                <!-- Card header with title -->
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-edit me-2"></i>
                        Úprava uživatele <!-- User edit heading -->
                    </h4>
                </div>
                <div class="card-body p-4">
                    <!-- Profile edit form -->
                    {form editProfileByUserForm}
                        <div class="row g-3">
                            <!-- Name input -->
                            <div class="col-12 col-md-6">
                                <label for="name" class="form-label fw-semibold">
                                    <i class="fas fa-user me-2 text-muted"></i>Jméno
                                    <span class="text-danger">*</span>
                                </label>
                                {input name}
                                <span class="invalid-feedback">
                                    {inputError name}
                                </span>
                            </div>

                            <!-- Surname input -->
                            <div class="col-12 col-md-6">
                                <label for="surname" class="form-label fw-semibold">
                                    <i class="fas fa-user me-2 text-muted"></i>Příjmení
                                    <span class="text-danger">*</span>
                                </label>
                                {input surname}
                                <span class="invalid-feedback">
                                    {inputError surname}
                                </span>
                            </div>

                            <!-- Email input -->
                            <div class="col-12 col-md-6">
                                <label for="email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-2 text-muted"></i>E-mail
                                    <span class="text-danger">*</span>
                                </label>
                                {input email}
                                <span class="invalid-feedback">
                                    {inputError email}
                                </span>
                            </div>
                            <!-- Username input -->
                            <div class="col-12 col-md-6">
                                <label for="username" class="form-label fw-semibold">
                                    <i class="fas fa-user-check me-2 text-muted"></i>Login
                                    <span class="text-danger">*</span>
                                </label>
                                {input username}
                                <span class="invalid-feedback">
                                    {inputError username}
                                </span>
                            </div>
                            <!-- City input -->
                            <div class="col-12 col-md-6">
                                <label for="city" class="form-label fw-semibold">
                                    <i class="fas fa-city me-2 text-muted"></i>Město
                                </label>
                                {input city}
                                <span class="invalid-feedback">
                                    {inputError city}
                                </span>
                            </div>

                            <!-- Street input -->
                            <div class="col-12 col-md-6">
                                <label for="street" class="form-label fw-semibold">
                                    <i class="fas fa-road me-2 text-muted"></i>Ulice
                                </label>
                                {input street}
                                <span class="invalid-feedback">
                                    {inputError street}
                                </span>
                            </div>

                            <!-- House number input -->
                            <div class="col-12 col-md-6">
                                <label for="houseNumber" class="form-label fw-semibold">
                                    <i class="fas fa-home me-2 text-muted"></i>Číslo popisné
                                </label>
                                {input houseNumber}
                                <span class="invalid-feedback">
                                    {inputError houseNumber}
                                </span>
                            </div>

                            <!-- Postal code input -->
                            <div class="col-12 col-md-6">
                                <label for="postalCode" class="form-label fw-semibold">
                                    <i class="fas fa-mail-bulk me-2 text-muted"></i>PSČ
                                </label>
                                {input postalCode}
                                <span class="invalid-feedback">
                                    {inputError postalCode}
                                </span>
                            </div>
                            <!-- Phone input -->
                            <div class="col-12">
                                <label for="phone" class="form-label fw-semibold">
                                    <i class="fas fa-phone me-2 text-muted"></i>Telefon
                                </label>
                                {input phone}
                                <span class="invalid-feedback">
                                    {inputError phone}
                                </span>
                            </div>
                            
                            <!-- Submit button for profile edit -->
                            <div class="col-12 col">
                                <div class="d-grid">
                                    {input send}
                                    <span class="invalid-feedback">
                                        {inputError send}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {/form}

                    <!-- Section for password change -->
                    <div class="d-flex justify-content-start align-items-center flex-row mt-5 mb-2">
                        <h4 class="fw-bold text-danger border-bottom border-2 pb-2 w-100">
                            <i class="fas fa-lock me-2"></i> Změna hesla
                        </h4>
                    </div>
                    <!-- Password reset form -->
                    {form resetPasswordForm}
                        <div class="row g-3">
                            <!-- Old password input -->
                            <div class="col-12">
                                <label for="newPassword" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-2 text-danger"></i>Staré heslo
                                    <span class="text-danger">*</span>
                                </label>
                                {input oldPassword class}
                            </div>

                            <!-- New password input -->
                            <div class="col-12 col-md-6">
                                <label for="newPasswordAgain" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-2 text-danger"></i>Potvrzení hesla
                                    <span class="text-danger">*</span>
                                </label>
                                {input newPassword}
                            </div>

                            <!-- New password confirmation input -->
                            <div class="col-12 col-md-6">
                                <label for="newPasswordAgain" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-2 text-danger"></i>Potvrzení hesla
                                    <span class="text-danger">*</span>
                                </label>
                                {input newPasswordAgain }
                            </div>

                            <!-- Submit button for password change -->
                            <div class="col-12">
                                <div class="d-grid">
                                    {input changePassword }
                                </div>
                            </div>
                        </div>
                    {/form}
                </div>
            </div>
        </div>
    </div>
{/block}
