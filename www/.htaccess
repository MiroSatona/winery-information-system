# Pretty URLs for Nette
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Skip real files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule .* - [L]

    # Skip real directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]

    # Route everything to index.php
    RewriteRule . index.php [L]
</IfModule>
