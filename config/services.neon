services:
	- App\Core\RouterFactory::createRouter
	- App\Model\Security\AuthorizatorFactory::create
	- App\Model\Security\MainAuthenticator
	- App\Model\Validation\ValidationDefinitions
	- App\Model\Security\SignUpWorker
	- App\Model\Vineyard\VineyardRepository
	- App\Model\WineVariety\WineVarietyRepository
	- App\Model\User\UserRepository
	- App\Model\Image\ImageRepository(%uploadsDir%, %uploadsDirWeb%)

	security.passwords: Nette\Security\Passwords(::PASSWORD_ARGON2ID, [memory_cost: 65536, time_cost: 4, threads: 3])


search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
