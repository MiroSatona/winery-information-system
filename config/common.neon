# see https://doc.nette.org/en/configuring

parameters:
	uploadsDir: 'assets/uploads'
	uploadsDirWeb: '/uploads'
	tmpImage: '/images'	

application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


database:
	dsn: 'mysql:host=db;dbname=iis_winery;charset=utf8mb4'
	user: iis_winery
	password: password


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\LatteExtension


assets:
	mapping:
		default:
			path: assets
			# type: vite  # Uncomment to activate Vite for asset building


di:
	export:
		parameters: no
		tags: no

session:
	expiration: 30 minutes

security:
	authentication:
		# period of inactivity after which the user will be logged out
		expiration: 30 minutes

		# where to store information about the logged-in user
		storage: session

